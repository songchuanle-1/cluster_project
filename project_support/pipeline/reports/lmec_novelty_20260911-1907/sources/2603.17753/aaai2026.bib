  issn = {0926-5805},
  journaltitle = {Automation in Construction},
  keywords = {Attention,Damage segmentation,Deep learning,Haar wavelet,Pyramid,RC structure},
  pages = {105746},
  shortjournal = {Automation in Construction},
  title = {Enhanced Damage Segmentation in {{RC}} Components Using Pyramid {{Haar}} Wavelet Downsampling and Attention {{U-net}}},
  url = {https://www.sciencedirect.com/science/article/pii/S0926580524004825},
  urldate = {2025-02-13},
  volume = {168},
  year = {{2024}}
}

@inproceedings{wangFastGraphCondensation2024,
  abstract = {The rapid development of Internet technology has given rise to a vast amount of graph-structured data. Graph Neural Networks (GNNs), as an effective method for various graph mining tasks, incurs substantial computational resource costs when dealing with large-scale graph data. A data-centric manner solution is proposed to condense the large graph dataset into a smaller one without sacrificing the predictive performance of GNNs. However, existing efforts condense graph-structured data through a computational intensive bi-level optimization architecture also suffer from massive computation costs. In this paper, we propose reforming the graph condensation problem as a Kernel Ridge Regression (KRR) task instead of iteratively training GNNs in the inner loop of bi-level optimization. More specifically, We propose a novel dataset condensation framework (GC-SNTK) for graph-structured data, where a Structure-based Neural Tangent Kernel (SNTK) is developed to capture the topology of graph and serves as the kernel function in KRR paradigm. Comprehensive experiments demonstrate the effectiveness of our proposed model in accelerating graph condensation while maintaining high prediction performance. The source code is available on \textbackslash hrefhttps://github.com/WANGLin0126/GCSNTK https://github.com/WANGLin0126/GCSNTK.},
  author = {Wang, Lin and Fan, Wenqi and Li, Jiatong and Ma, Yao and Li, Qing},
  booktitle = {Proceedings of the {{ACM Web Conference}} 2024},
  date = {2024-05-13},
  doi = {10.1145/3589334.3645694},
  file = {E:\science\all_papers\zotero\storage\WBVGRRJ3\Wang 等 - 2024 - Fast Graph Condensation with Structure-based Neural Tangent Kernel.pdf},
  isbn = {979-8-4007-0171-9},
  location = {New York, NY, USA},
  pages = {4439--4448},
  publisher = {Association for Computing Machinery},
  series = {{{WWW}} '24},
  title = {Fast {{Graph Condensation}} with {{Structure-based Neural Tangent Kernel}}},
  url = {https://doi.org/10.1145/3589334.3645694},
