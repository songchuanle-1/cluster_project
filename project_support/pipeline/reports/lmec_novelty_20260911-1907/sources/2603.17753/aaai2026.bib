  journaltitle = {IEEE Internet of Things Journal},
  keywords = {Artificial intelligence (AI),Behavioral sciences,brain-computer interactions,Collision avoidance,edge computing,extended reality (XR),Feature extraction,Internet of Things (IoT),metaverse,Metaverse,Rendering (computer graphics),Solid modeling,Three-dimensional displays},
  number = {18},
  pages = {15788--15809},
  shorttitle = {Virtual-{{Reality Interpromotion Technology}} for {{Metaverse}}},
  title = {Virtual-{{Reality Interpromotion Technology}} for {{Metaverse}}: {{A Survey}}},
