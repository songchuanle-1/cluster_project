  doi = {10.1145/3511808.3557364},
  file = {E:\science\all_papers\zotero\storage\SNQM895X\Zeng 等 - 2022 - Interactive Contrastive Learning for Self-Supervised Entity Alignment.pdf},
  isbn = {978-1-4503-9236-5},
