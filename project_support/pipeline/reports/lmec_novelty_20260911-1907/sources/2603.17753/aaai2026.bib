  shorttitle = {A {{Survey}} on {{Text-guided 3D Visual Grounding}}},
  title = {A {{Survey}} on {{Text-guided 3D Visual Grounding}}: {{Elements}}, {{Recent Advances}}, and {{Future Directions}}},
