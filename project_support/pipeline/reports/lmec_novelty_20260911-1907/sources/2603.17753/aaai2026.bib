  pubstate = {prepublished},
  shorttitle = {{{AugRefer}}},
  title = {{{AugRefer}}: {{Advancing 3D Visual Grounding}} via {{Cross-Modal Augmentation}} and {{Spatial Relation-based Referring}}},
