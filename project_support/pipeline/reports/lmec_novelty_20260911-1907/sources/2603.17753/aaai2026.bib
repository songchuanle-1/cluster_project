  publisher = {PMLR},
  shorttitle = {{{EfficientNetV2}}},
  title = {{{EfficientNetV2}}: {{Smaller Models}} and {{Faster Training}}},
  url = {https://proceedings.mlr.press/v139/tan21a.html},
