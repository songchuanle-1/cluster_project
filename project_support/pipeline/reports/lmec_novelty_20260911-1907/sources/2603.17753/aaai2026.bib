  issn = {1886-1784},
  journaltitle = {Archives of Computational Methods in Engineering},
  langid = {english},
  number = {2},
  pages = {1057--1080},
  shortjournal = {Arch Computat Methods Eng},
  shorttitle = {Augmented {{Reality}}},
  title = {Augmented {{Reality}}: {{A Comprehensive Review}}},
