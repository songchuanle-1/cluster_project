  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  pubstate = {prepublished},
  shorttitle = {{{Search3D}}},
  title = {{{Search3D}}: {{Hierarchical Open-Vocabulary 3D Segmentation}}},
  url = {http://arxiv.org/abs/2409.18431},
