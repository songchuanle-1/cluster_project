  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  pubstate = {prepublished},
  shorttitle = {{{SeCG}}},
  title = {{{SeCG}}: {{Semantic-Enhanced 3D Visual Grounding}} via {{Cross-modal Graph Attention}}},
  url = {http://arxiv.org/abs/2403.08182},
  urldate = {2024-10-09},
