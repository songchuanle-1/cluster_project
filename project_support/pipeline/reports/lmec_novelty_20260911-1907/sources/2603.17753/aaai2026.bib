  keywords = {3D dense captioning,3D point cloud,Grounding,Point cloud compression,Solid modeling,Surveys,Task analysis,Three-dimensional displays,vision-language bridging,visual captioning,Visualization},
  number = {3},
  pages = {1322--1338},
  shorttitle = {A {{Comprehensive Survey}} of {{3D Dense Captioning}}},
  title = {A {{Comprehensive Survey}} of {{3D Dense Captioning}}: {{Localizing}} and {{Describing Objects}} in {{3D Scenes}}},
