  series = {{{CIKM}} '22},
  title = {Interactive {{Contrastive Learning}} for {{Self-Supervised Entity Alignment}}},
  url = {https://dl.acm.org/doi/10.1145/3511808.3557364},
  urldate = {2024-12-25},
